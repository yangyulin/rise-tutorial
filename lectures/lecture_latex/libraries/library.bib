@InProceedings{Spletzer2003IROS,
  Title                    = {A bounded uncertainty approach to multi-robot localization},
  Author                   = {Spletzer, J. R. and Taylor, C. J.},
  Booktitle                = {Intelligent Robots and Systems, 2003. ({IROS} 2003). Proceedings. 2003 {IEEE}/{RSJ} International Conference on},
  Year                     = {2003},
  Month                    = oct,
  Pages                    = {1258--1265},
  Volume                   = {2},

  Abstract                 = {We offer a new approach to the multi-robot localization problem. Using an unknown-but-bounded model for sensor error, we are able to define convex polytopes in the configuration space of the robot team that represent the set of configurations consistent with all sensor measurements. Estimates for the uncertainty in various parameters of the team's configuration such as the absolute position of a single robot, or the relative positions of two or more nodes can be obtained by projecting this polytope onto appropriately chosen subspaces of the configuration space. We propose a novel approach to approximating these projections using linear programming techniques. The approach can handle both bearing and range measurements with a computational complexity scaling polynomially in the number of roots. Finally, the workload is readily distributed - requiring only the communication of sensor measurements between robots. We provide simulation results for this approach implemented on a multi-robot team.},
  File                     = {Spletzer2003IROS.pdf:Spletzer2003IROS.pdf:PDF},
  Keywords                 = {computational complexity, cooperative systems, linear programming, multi-robot systems, position control, sensor fusion},
  Owner                    = {paul},
  Timestamp                = {2010.03.30}
}

@InProceedings{Spletzer2005ICRA,
  Title                    = {Optimal Positioning Strategies for Shape Changes in Robot Teams},
  Author                   = {Spletzer, J. R. and Fierro, R.},
  Booktitle                = {Robotics and Automation, 2005. {ICRA} 2005. Proceedings of the 2005 {IEEE} International Conference on},
  Year                     = {2005},
  Month                    = apr,
  Pages                    = {742--747},

  Abstract                 = {In this paper, we consider the task of repositioning a formation of robots to a new shape while minimizing either the maximum distance that any robot travels, or the total distance traveled by the formation. We show that optimal solutions in SE (2) can be achieved for either metric through second-order cone programming (SOCP) techniques. For the case where the orientation of the new formation shape is fixed, we obtain optimal solutions in both R2and R3. The latter also allows for complete regulation of the formation size via constraints on the shape scale. We expect that these results will prove useful for extending the mission lives of robot formations and mobile ad-hoc networks (MANETs).},
  File                     = {Spletzer2005ICRA.pdf:Spletzer2005ICRA.pdf:PDF},
  Owner                    = {paul},
  Timestamp                = {2010.03.30}
}

