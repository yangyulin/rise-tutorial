@InProceedings{Olson2006ICRA,
  Title                    = {Fast iterative alignment of pose graphs with poor initial estimates},
  Author                   = {Olson, E. and Leonard, J. and Teller, S.},
  Booktitle                = ICRA,
  Year                     = {2006},

  Address                  = {Orlando, FL},
  Month                    = may # { 15--19, },
  Pages                    = {2262--2269},

  Abstract                 = {A robot exploring an environment can estimate its own motion and the relative positions of features in the environment. Simultaneous localization and mapping (SLAM) algorithms attempt to fuse these estimates to produce a map and a robot trajectory. The constraints are generally non-linear, thus SLAM can be viewed as a non-linear optimization problem. The optimization can be difficult, due to poor initial estimates arising from odometry data, and due to the size of the state space. We present a fast non-linear optimization algorithm that rapidly recovers the robot trajectory, even when given a poor initial estimate. Our approach uses a variant of stochastic gradient descent on an alternative state-space representation that has good stability and computational properties. We compare our algorithm to several others, using both real and synthetic data sets},
  Owner                    = {paul},
  Timestamp                = {2010.03.01}
}

@Article{Olson2006JOE,
  Title                    = {Robust Range-Only Beacon Localization},
  Author                   = {Edwin Olson and John J. Leonard and Seth Teller},
  Journal                  = {{IEEE} Journal of Oceanic Engineering},
  Year                     = {2006},

  Month                    = oct,
  Number                   = {4},
  Pages                    = {949--958},
  Volume                   = {31},

  Abstract                 = {In this paper, we present a system capable of simultaneously estimating the position of an autonomous underwater vehicle (AUV) and the positions of stationary range-only beacons. Notably, our system does not require beacon positions a priori, and our system performs well even when range measurements are severely degraded by noise and outliers. We present a powerful outlier rejection method that can identify groups of range measurements that are consistent with each other, and a method for initializing beacon positions in an extended Kalman filter (EKF). We have successfully applied our algorithms to real- world data and have demonstrated a simultaneous localization and mapping (SLAM) system whose navigation performance is comparable to that of systems that assume known beacon locations},
  Doi                      = {10.1109/JOE.2006.880386},
  File                     = {Olson2006JOE.pdf:Olson2006JOE.pdf:PDF},
  ISSN                     = {0364-9059},
  Keywords                 = {Kalman filters, SLAM (robots), acoustic signal processing, direction- of-arrival estimation, mobile robots, remotely operated vehicles, underwater vehicles},
  Owner                    = {paul},
  Timestamp                = {2010.03.30}
}

